## STEP 6: Python Data Analysis

```python
# analysis.py
import pandas as pd
from sqlalchemy import create_engine
import matplotlib.pyplot as plt
import seaborn as sns

DB_URL = "postgresql://postgres:yourpassword@localhost:5432/phonepe_db"
engine = create_engine(DB_URL)

# ── Load data ──────────────────────────────────────────────────────────────────
df_txn   = pd.read_sql("SELECT * FROM aggregated_transaction", engine)
df_user  = pd.read_sql("SELECT * FROM aggregated_user", engine)
df_map   = pd.read_sql("SELECT * FROM map_transaction", engine)

# ── Plot 1: Transaction amount by type ────────────────────────────────────────
type_grp = df_txn.groupby("transaction_type")["transaction_amount"].sum().sort_values()
plt.figure(figsize=(10, 6))
type_grp.plot(kind="barh", color="steelblue")
plt.title("Total Transaction Amount by Type")
plt.xlabel("Amount (₹)")
plt.tight_layout()
plt.savefig("txn_by_type.png")
plt.show()

# ── Plot 2: Top 10 states ─────────────────────────────────────────────────────
top_states = df_txn.groupby("state")["transaction_amount"].sum().nlargest(10)
plt.figure(figsize=(10, 6))
top_states.plot(kind="bar", color="coral")
plt.title("Top 10 States by Transaction Amount")
plt.ylabel("Amount (₹)")
plt.xticks(rotation=45, ha="right")
plt.tight_layout()
plt.savefig("top_states.png")
plt.show()

# ── Plot 3: Year-wise trend line ───────────────────────────────────────────────
year_grp = df_txn.groupby("year")["transaction_amount"].sum()
plt.figure(figsize=(8, 5))
year_grp.plot(kind="line", marker="o", color="green")
plt.title("Year-wise Transaction Trend")
plt.ylabel("Amount (₹)")
plt.tight_layout()
plt.savefig("yearly_trend.png")
plt.show()

# ── Plot 4: Mobile brand share (pie) ─────────────────────────────────────────
brand_grp = df_user.groupby("brand")["user_count"].sum().nlargest(8)
plt.figure(figsize=(8, 8))
brand_grp.plot(kind="pie", autopct="%1.1f%%")
plt.title("Top Mobile Brands by User Count")
plt.ylabel("")
plt.tight_layout()
plt.savefig("brand_pie.png")
plt.show()

print("✅ All charts saved!")
```

