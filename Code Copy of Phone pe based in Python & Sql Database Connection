## STEP 4: Extract & Load Data from JSON to SQL (ETL)

```python
# etl_load.py
import os
import json
import pandas as pd
from sqlalchemy import create_engine

# ── DB Connection ──────────────────────────────────────────────────────────────
DB_URL = "postgresql://postgres:yourpassword@localhost:5432/phonepe_db"
engine = create_engine(DB_URL)
BASE   = "phonepe_pulse/data"

# ── Helper ─────────────────────────────────────────────────────────────────────
def load_json(path):
    with open(path, "r") as f:
        return json.load(f)

# ══════════════════════════════════════════════════════════════════════════════
# 4A. AGGREGATED TRANSACTION
# ══════════════════════════════════════════════════════════════════════════════
def extract_aggregated_transaction():
    records = []
    root = os.path.join(BASE, "aggregated", "transaction", "country", "india", "state")
    for state in os.listdir(root):
        for year in os.listdir(os.path.join(root, state)):
            for file in os.listdir(os.path.join(root, state, year)):
                quarter = int(file.replace(".json", ""))
                data    = load_json(os.path.join(root, state, year, file))
                for txn in data["data"]["transactionData"]:
                    records.append({
                        "state": state,
                        "year": int(year),
                        "quarter": quarter,
                        "transaction_type": txn["name"],
                        "transaction_count": txn["paymentInstruments"][0]["count"],
                        "transaction_amount": txn["paymentInstruments"][0]["amount"]
                    })
    df = pd.DataFrame(records)
    df.to_sql("aggregated_transaction", engine, if_exists="replace", index=False)
    print(f"aggregated_transaction loaded: {len(df)} rows")

# ══════════════════════════════════════════════════════════════════════════════
# 4B. AGGREGATED USER
# ══════════════════════════════════════════════════════════════════════════════
def extract_aggregated_user():
    records = []
    root = os.path.join(BASE, "aggregated", "user", "country", "india", "state")
    for state in os.listdir(root):
        for year in os.listdir(os.path.join(root, state)):
            for file in os.listdir(os.path.join(root, state, year)):
                quarter = int(file.replace(".json", ""))
                data    = load_json(os.path.join(root, state, year, file))
                users   = data["data"].get("usersByDevice") or []
                for u in users:
                    records.append({
                        "state": state,
                        "year": int(year),
                        "quarter": quarter,
                        "brand": u["brand"],
                        "user_count": u["count"],
                        "user_percentage": u["percentage"]
                    })
    df = pd.DataFrame(records)
    df.to_sql("aggregated_user", engine, if_exists="replace", index=False)
    print(f"aggregated_user loaded: {len(df)} rows")

# ══════════════════════════════════════════════════════════════════════════════
# 4C. AGGREGATED INSURANCE
# ══════════════════════════════════════════════════════════════════════════════
def extract_aggregated_insurance():
    records = []
    root = os.path.join(BASE, "aggregated", "insurance", "country", "india", "state")
    for state in os.listdir(root):
        for year in os.listdir(os.path.join(root, state)):
            for file in os.listdir(os.path.join(root, state, year)):
                quarter = int(file.replace(".json", ""))
                data    = load_json(os.path.join(root, state, year, file))
                for ins in data["data"]["transactionData"]:
                    records.append({
                        "state": state,
                        "year": int(year),
                        "quarter": quarter,
                        "insurance_type": ins["name"],
                        "insurance_count": ins["paymentInstruments"][0]["count"],
                        "insurance_amount": ins["paymentInstruments"][0]["amount"]
                    })
    df = pd.DataFrame(records)
    df.to_sql("aggregated_insurance", engine, if_exists="replace", index=False)
    print(f"aggregated_insurance loaded: {len(df)} rows")

# ══════════════════════════════════════════════════════════════════════════════
# 4D. MAP TRANSACTION
# ══════════════════════════════════════════════════════════════════════════════
def extract_map_transaction():
    records = []
    root = os.path.join(BASE, "map", "transaction", "hover", "country", "india", "state")
    for state in os.listdir(root):
        for year in os.listdir(os.path.join(root, state)):
            for file in os.listdir(os.path.join(root, state, year)):
                quarter = int(file.replace(".json", ""))
                data    = load_json(os.path.join(root, state, year, file))
                for dist in data["data"]["hoverDataList"]:
                    records.append({
                        "state": state,
                        "year": int(year),
                        "quarter": quarter,
                        "district": dist["name"],
                        "transaction_count": dist["metric"][0]["count"],
                        "transaction_amount": dist["metric"][0]["amount"]
                    })
    df = pd.DataFrame(records)
    df.to_sql("map_transaction", engine, if_exists="replace", index=False)
    print(f"map_transaction loaded: {len(df)} rows")

# ══════════════════════════════════════════════════════════════════════════════
# 4E. MAP USER
# ══════════════════════════════════════════════════════════════════════════════
def extract_map_user():
    records = []
    root = os.path.join(BASE, "map", "user", "hover", "country", "india", "state")
    for state in os.listdir(root):
        for year in os.listdir(os.path.join(root, state)):
            for file in os.listdir(os.path.join(root, state, year)):
                quarter = int(file.replace(".json", ""))
                data    = load_json(os.path.join(root, state, year, file))
                for dist in data["data"]["hoverData"].items():
                    records.append({
                        "state": state,
                        "year": int(year),
                        "quarter": quarter,
                        "district": dist[0],
                        "registered_users": dist[1]["registeredUsers"],
                        "app_opens": dist[1]["appOpens"]
                    })
    df = pd.DataFrame(records)
    df.to_sql("map_user", engine, if_exists="replace", index=False)
    print(f"map_user loaded: {len(df)} rows")

# ══════════════════════════════════════════════════════════════════════════════
# 4F. TOP TRANSACTION
# ══════════════════════════════════════════════════════════════════════════════
def extract_top_transaction():
    records = []
    root = os.path.join(BASE, "top", "transaction", "country", "india", "state")
    for state in os.listdir(root):
        for year in os.listdir(os.path.join(root, state)):
            for file in os.listdir(os.path.join(root, state, year)):
                quarter = int(file.replace(".json", ""))
                data    = load_json(os.path.join(root, state, year, file))
                for item in data["data"]["pincodes"]:
                    records.append({
                        "state": state,
                        "year": int(year),
                        "quarter": quarter,
                        "pincode": item["entityName"],
                        "transaction_count": item["metric"]["count"],
                        "transaction_amount": item["metric"]["amount"]
                    })
    df = pd.DataFrame(records)
    df.to_sql("top_transaction", engine, if_exists="replace", index=False)
    print(f"top_transaction loaded: {len(df)} rows")

# ── Run all ETL functions ───────────────────────────────────────────────────
if __name__ == "__main__":
    extract_aggregated_transaction()
    extract_aggregated_user()
    extract_aggregated_insurance()
    extract_map_transaction()
    extract_map_user()
    extract_top_transaction()
    print("\n All data loaded into PostgreSQL successfully!")
```

