## STEP 7: Streamlit Dashboard

```python
# app.py
import streamlit as st
import pandas as pd
import plotly.express as px
from sqlalchemy import create_engine

# ── Page config ───────────────────────────────────────────────────────────────
st.set_page_config(page_title="PhonePe Insights", layout="wide", page_icon="📱")
st.title("📱 PhonePe Transaction Insights Dashboard")

DB_URL = "postgresql://postgres:yourpassword@localhost:5432/phonepe_db"

@st.cache_data
def load(query):
    engine = create_engine(DB_URL)
    return pd.read_sql(query, engine)

# ── Sidebar filters ───────────────────────────────────────────────────────────
st.sidebar.header("Filters")
df_raw  = load("SELECT * FROM aggregated_transaction")
years   = sorted(df_raw["year"].unique())
year    = st.sidebar.selectbox("Select Year", ["All"] + years)
quarter = st.sidebar.selectbox("Select Quarter", ["All", 1, 2, 3, 4])

df = df_raw.copy()
if year != "All":
    df = df[df["year"] == year]
if quarter != "All":
    df = df[df["quarter"] == quarter]

# ── KPI cards ────────────────────────────────────────────────────────────────
col1, col2, col3 = st.columns(3)
col1.metric("Total Transactions", f"{df['transaction_count'].sum():,.0f}")
col2.metric("Total Amount (₹ Cr)", f"{df['transaction_amount'].sum()/1e7:,.2f}")
col3.metric("States Covered", df["state"].nunique())

st.markdown("---")

# ── Tab layout ────────────────────────────────────────────────────────────────
tab1, tab2, tab3, tab4 = st.tabs(
    ["📊 Transactions", "🗺️ Map View", "👥 Users", "🛡️ Insurance"])

# TAB 1 — Transactions
with tab1:
    c1, c2 = st.columns(2)

    # Bar: Transaction type
    type_grp = df.groupby("transaction_type")["transaction_amount"].sum().reset_index()
    fig1 = px.bar(type_grp, x="transaction_type", y="transaction_amount",
                  title="Transaction Amount by Type", color="transaction_type")
    c1.plotly_chart(fig1, use_container_width=True)

    # Bar: Top states
    state_grp = df.groupby("state")["transaction_amount"].sum().nlargest(10).reset_index()
    fig2 = px.bar(state_grp, x="transaction_amount", y="state", orientation="h",
                  title="Top 10 States by Amount", color="transaction_amount",
                  color_continuous_scale="Blues")
    c2.plotly_chart(fig2, use_container_width=True)

    # Line: Year/quarter trend
    trend = df_raw.groupby(["year", "quarter"])["transaction_amount"].sum().reset_index()
    trend["period"] = trend["year"].astype(str) + " Q" + trend["quarter"].astype(str)
    fig3 = px.line(trend, x="period", y="transaction_amount",
                   title="Quarterly Transaction Trend", markers=True)
    st.plotly_chart(fig3, use_container_width=True)

# TAB 2 — Map View
with tab2:
    map_df = load("SELECT state, SUM(transaction_amount) AS total FROM map_transaction GROUP BY state")
    fig_map = px.choropleth(
        map_df,
        geojson="https://gist.githubusercontent.com/jbrobst/56c13bbbf9d97d187fea01ca62ea5112/raw/e388c4cae20aa53cb5090210a42ebb9b765c0a36/india_states.geojson",
        featureidkey="properties.ST_NM",
        locations="state",
        color="total",
        color_continuous_scale="Viridis",
        title="State-wise Transaction Amount"
    )
    fig_map.update_geos(fitbounds="locations", visible=False)
    st.plotly_chart(fig_map, use_container_width=True)

# TAB 3 — Users
with tab3:
    user_df  = load("SELECT * FROM aggregated_user")
    brand_df = user_df.groupby("brand")["user_count"].sum().nlargest(10).reset_index()
    fig_b = px.pie(brand_df, names="brand", values="user_count",
                   title="Top 10 Mobile Brands by User Count")
    st.plotly_chart(fig_b, use_container_width=True)

    mu_df = load("""
        SELECT state, SUM(registered_users) AS reg_users, SUM(app_opens) AS app_opens
        FROM map_user GROUP BY state ORDER BY reg_users DESC LIMIT 15
    """)
    fig_mu = px.bar(mu_df, x="state", y=["reg_users", "app_opens"],
                    barmode="group", title="Top 15 States — Registered Users vs App Opens")
    st.plotly_chart(fig_mu, use_container_width=True)

# TAB 4 — Insurance
with tab4:
    ins_df = load("""
        SELECT state, SUM(insurance_count) AS count, SUM(insurance_amount) AS amount
        FROM aggregated_insurance GROUP BY state ORDER BY amount DESC LIMIT 10
    """)
    fig_i = px.bar(ins_df, x="state", y="amount",
                   title="Top 10 States by Insurance Amount", color="amount",
                   color_continuous_scale="Reds")
    st.plotly_chart(fig_i, use_container_width=True)

st.sidebar.markdown("---")
st.sidebar.info("Data Source: PhonePe Pulse GitHub")
