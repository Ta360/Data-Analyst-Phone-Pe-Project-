## STEP 5: SQL Queries for Business Analysis

```sql
-- ── 1. Total transaction amount by type ──────────────────────────────────────
SELECT transaction_type,
       SUM(transaction_count)  AS total_count,
       ROUND(SUM(transaction_amount), 2) AS total_amount
FROM aggregated_transaction
GROUP BY transaction_type
ORDER BY total_amount DESC;

-- ── 2. Top 10 states by transaction amount ────────────────────────────────────
SELECT state,
       SUM(transaction_count)  AS total_count,
       ROUND(SUM(transaction_amount), 2) AS total_amount
FROM aggregated_transaction
GROUP BY state
ORDER BY total_amount DESC
LIMIT 10;

-- ── 3. Year-wise transaction trend ───────────────────────────────────────────
SELECT year,
       SUM(transaction_count)  AS total_count,
       ROUND(SUM(transaction_amount), 2) AS total_amount
FROM aggregated_transaction
GROUP BY year
ORDER BY year;

-- ── 4. Top 10 districts by transaction amount ─────────────────────────────────
SELECT state, district,
       SUM(transaction_count)  AS total_count,
       ROUND(SUM(transaction_amount), 2) AS total_amount
FROM map_transaction
GROUP BY state, district
ORDER BY total_amount DESC
LIMIT 10;

-- ── 5. Top mobile brands by registered users ──────────────────────────────────
SELECT brand,
       SUM(user_count) AS total_users
FROM aggregated_user
GROUP BY brand
ORDER BY total_users DESC
LIMIT 10;

-- ── 6. Quarterly performance per year ────────────────────────────────────────
SELECT year, quarter,
       ROUND(SUM(transaction_amount), 2) AS total_amount
FROM aggregated_transaction
GROUP BY year, quarter
ORDER BY year, quarter;

-- ── 7. Top 10 pincodes by transaction amount ──────────────────────────────────
SELECT state, pincode,
       SUM(transaction_count)  AS total_count,
       ROUND(SUM(transaction_amount), 2) AS total_amount
FROM top_transaction
GROUP BY state, pincode
ORDER BY total_amount DESC
LIMIT 10;

-- ── 8. State-wise registered users ───────────────────────────────────────────
SELECT state,
       SUM(registered_users) AS total_registered_users,
       SUM(app_opens)        AS total_app_opens
FROM map_user
GROUP BY state
ORDER BY total_registered_users DESC;

-- ── 9. Insurance transactions by state ───────────────────────────────────────
SELECT state,
       SUM(insurance_count)  AS total_count,
       ROUND(SUM(insurance_amount), 2) AS total_amount
FROM aggregated_insurance
GROUP BY state
ORDER BY total_amount DESC;
```

